+            return error.InvalidData;
+        }
+        if (std.mem.readInt(u32, data[8..12], .big) != 13 or
+            !std.mem.eql(u8, data[12..16], "IHDR"))
+        {
+            return error.InvalidData;
+        }
+        self.image.width = std.mem.readInt(u32, data[16..20], .big);
+        self.image.height = std.mem.readInt(u32, data[20..24], .big);
+        if (self.image.width == 0 or self.image.height == 0) {
+            return error.InvalidData;
+        }
+    }
