+    /// Parse the PNG IHDR chunk to obtain image dimensions without
+    /// decoding the full image.
+    fn readPngDimensions(self: *LoadingImage) !void {
+        const data = self.data.items;
+        const signature = [8]u8{ 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A };
