{
  "name": "@zem-sh/terminal",
  "version": "0.1.2",
  "description": "Terminal emulator core — the Ghostty VT engine compiled to WebAssembly, GPU text rendering, ligature shaping, themes and font fallback",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zem-sh/terminal.git"
  },
  "homepage": "https://github.com/zem-sh/terminal#readme",
  "bugs": {
    "url": "https://github.com/zem-sh/terminal/issues"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "ghostty",
    "webassembly",
    "wasm",
    "webgpu",
    "ligatures"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "assets",
    "wasm/build.zig",
    "wasm/build.zig.zon",
    "wasm/.zig-version",
    "wasm/src",
    "wasm/patches"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:wasm": "tsx scripts/build-wasm.ts",
    "build:themes": "tsx scripts/generate-builtin-themes.ts"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69",
    "text-shaper": "0.1.22"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
